---
import { site } from '../site';

const year = new Date().getUTCFullYear();
---

<footer
  class="mt-auto flex flex-col gap-2.5 border-line border-t px-4 pt-6 pb-7 text-dim text-xs print:hidden md:px-20"
>
  <div class="flex flex-wrap justify-between gap-4"><span>+++ ATH0</span><span>NO CARRIER</span></div>
  <div class="flex flex-col items-center gap-1 md:flex-row md:justify-between md:gap-4">
    <span class="flex flex-col items-center md:flex-row md:gap-2">
      <span>© {year} {site.name}</span>
      <span class="hidden md:inline">·</span>
      <span>built with Astro · hosted on GitHub Pages</span>
    </span>
    <span>
      <span class="hidden md:inline">press <button type="button" data-keys-open class="cursor-pointer text-fg">?</button> for keys ·</span>
      <a href="/rss.xml">rss</a> · <a href="/llms.txt">llms.txt</a> · <a href="/privacy/">privacy</a>
    </span>
  </div>
</footer>
