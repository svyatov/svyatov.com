---
import { site } from '../site';

const links = [
  ...site.socials.filter((s) => s.label === 'github' || s.label === 'linkedin'),
  { label: 'email', href: `mailto:${site.email}` },
];
---

<div class="flex items-center gap-5 border border-line bg-surface p-5">
  <div class="flex size-14 shrink-0 items-center justify-center border border-accent font-semibold text-accent text-xl">&gt;_</div>
  <div class="flex flex-col gap-1 text-sm">
    <span class="font-semibold">{site.name}</span>
    <span class="text-dim">{site.bio}</span>
    <div class="mt-1 flex flex-wrap gap-3">
      {links.map((l) => <a href={l.href} rel={l.label === 'email' ? undefined : 'me'}>[ {l.label} ]</a>)}
    </div>
  </div>
</div>
