---
import { site } from '../site';

const links = [
  ...site.socials.filter((s) => s.label === 'github' || s.label === 'linkedin'),
  { label: 'email', href: `mailto:${site.email}` },
];
---

<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm">
  <span class="inline-flex items-center gap-3">
    <span class="inline-flex items-center gap-1.5 font-semibold text-accent tracking-logo">
      <span>&gt;</span><span>whoami</span><span class="inline-block h-[1.05em] w-[0.55em] bg-accent"></span>
    </span>
    <span class="font-semibold">{site.name}</span>
  </span>
  <span class="hidden text-dim sm:inline">·</span>
  <span class="inline-flex flex-wrap justify-center gap-3">
    {links.map((l) => <a href={l.href} rel={l.label === 'email' ? undefined : 'me'}>[ {l.label} ]</a>)}
  </span>
</div>
