---
interface Props {
  language: string;
}

const { language } = Astro.props;

const colors: Record<string, string> = {
  Ruby: 'bg-lang-ruby',
  JavaScript: 'bg-lang-javascript',
  TypeScript: 'bg-lang-typescript',
  Go: 'bg-lang-go',
  HTML: 'bg-lang-html',
  Skills: 'bg-lang-skills',
};
---

<span class:list={['inline-block size-2.5 shrink-0', colors[language] ?? 'bg-dim']} title={language}></span>
