---
interface Props {
  fonts: readonly string[];
}

const { fonts } = Astro.props;
---

<pre
  aria-hidden="true"
  class="cursor-pointer select-none font-mono text-3xs text-accent leading-banner md:text-md md:leading-none"
  data-fonts={JSON.stringify(fonts)}>{`\n${fonts[0]}`}</pre>

<script>
  // Click the banner: it morphs into the next font in the list, cells scrambling in a random sweep direction.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NOISE = [...'░▒▓█▄▀╬╠╣═║/|_-=+*#%'];
  const SWEEPS = [
    (_r: number, c: number) => c,
    (_r: number, c: number) => 1 - c,
    (r: number) => r,
    (_r: number, c: number) => Math.abs(c - 0.5) * 2,
    () => Math.random(),
  ];
  const DURATION = 700;
  const rand = <T,>(list: readonly T[]) => list[Math.floor(Math.random() * list.length)];

  for (const pre of document.querySelectorAll<HTMLPreElement>('pre[data-fonts]')) {
    const fonts: string[] = JSON.parse(pre.dataset.fonts ?? '[]');
    let busy = false;
    pre.addEventListener('click', () => {
      const from = pre.textContent ?? '';
      const to = fonts[(fonts.indexOf(from) + 1) % fonts.length];
      if (busy || to === from) return;
      if (reduced) {
        pre.textContent = to;
        return;
      }
      const a = from.split('\n');
      const b = to.split('\n');
      const rows = Math.max(a.length, b.length);
      const cols = Math.max(...a.map((l) => l.length), ...b.map((l) => l.length));
      const sweep = rand(SWEEPS);
      const settle = Array.from({ length: rows }, (_, r) =>
        Array.from({ length: cols }, (_, c) => sweep(r / (rows - 1), c / (cols - 1)) * 0.7 + Math.random() * 0.3),
      );
      const cell = (line: string, c: number) => line[c] ?? ' ';
      busy = true;
      const start = performance.now();
      const frame = (now: number) => {
        const p = (now - start) / DURATION;
        if (p >= 1) {
          pre.textContent = to;
          busy = false;
          return;
        }
        pre.textContent = settle
          .map((row, r) =>
            row
              .map((t, c) => {
                const old = cell(a[r] ?? '', c);
                const next = cell(b[r] ?? '', c);
                if (p >= t) return next;
                if (p < t - 0.25 || (old === ' ' && next === ' ')) return old;
                return rand(NOISE);
              })
              .join(''),
          )
          .join('\n');
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    });
  }
</script>
