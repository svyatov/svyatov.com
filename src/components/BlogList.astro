---
import { getCollection } from 'astro:content';
import { banners } from '../data/banners';
import { feeds } from '../lib/feeds';
import { countBy, type Post, tagUrl, yearOf } from '../lib/posts';
import { site } from '../site';
import Banner from './Banner.astro';
import PostRow from './PostRow.astro';
import Tag from './Tag.astro';

interface Props {
  posts: Post[];
  heading?: string;
  prev?: string;
  next?: string;
  page?: { current: number; total: number };
  activeTag?: string;
}

const { posts, heading, prev, next, page, activeTag } = Astro.props;
const all = await getCollection('blog');
const tags = [...countBy(all, (p) => p.data.tags)].sort((a, b) => b[1] - a[1] || String(a[0]).localeCompare(String(b[0])));
const years = [...countBy(all, (p) => [yearOf(p.data.date)])].sort((a, b) => Number(b[0]) - Number(a[0]));
---

<div class="flex flex-col gap-8 px-4 pt-10 pb-10 md:px-20 md:pt-18 md:pb-14">
  <section class="flex flex-col gap-5">
    <Banner fonts={banners.blog} />
    <div class="text-lg">
      <p class="text-dim">$ tail -f ~/blog{heading ? ` | grep ${heading}` : ''}</p>
      <h1>{heading ? `Posts filed under ${heading}.` : site.blogTagline}<span class="cursor-blink"></span></h1>
    </div>
  </section>
  <div class="flex flex-col gap-10 lg:grid lg:grid-cols-[18.75rem_minmax(0,1fr)] lg:gap-16">
    <section class="flex flex-col lg:-mx-3 lg:max-w-list">
      <div class="flex flex-col max-lg:-mt-6">{posts.map((post) => <PostRow post={post} />)}</div>
      {
        page && (
          <nav aria-label="Pagination" class="flex justify-between py-2 text-sm lg:px-3">
            {next ? <a href={next} rel="next" data-key="," class="text-fg hover:text-accent hover:no-underline">[<u class="text-accent no-underline">,</u>] older</a> : <span class="text-dim">[,] older</span>}
            <span class="text-dim">page {page.current} / {page.total}</span>
            {prev ? <a href={prev} rel="prev" data-key="." class="text-fg hover:text-accent hover:no-underline">newer [<u class="text-accent no-underline">.</u>]</a> : <span class="text-dim">newer [.]</span>}
          </nav>
        )
      }
    </section>
    <aside class="flex flex-col gap-8 text-sm lg:order-first lg:pt-6">
      <div class="flex flex-col gap-3">
        <h2 class="font-semibold text-2xs text-accent tracking-label">TAGS</h2>
        <div class="flex flex-wrap gap-2">
          {tags.map(([tag]) => <Tag href={tagUrl(String(tag))} active={tag === activeTag}>{tag}</Tag>)}
        </div>
      </div>
      <div class="flex flex-col gap-3 border border-line bg-surface p-5">
        <h2 class="font-semibold text-2xs text-accent tracking-label">SUBSCRIBE</h2>
        <p>No newsletter. Just a feed.</p>
        <div class="flex gap-3">{feeds.map((f) => <a href={f.href}>[ {f.label} ]</a>)}</div>
      </div>
      <div class="flex flex-col gap-3">
        <h2 class="font-semibold text-2xs text-accent tracking-label">ARCHIVE</h2>
        <div class="flex flex-col gap-1.5">
          {
            years.map(([year, n]) => (
              <a href={`/blog/year/${year}/`} class="text-fg">
                {year} <span class="text-dim">·· {n}</span>
              </a>
            ))
          }
        </div>
      </div>
    </aside>
  </div>
</div>
