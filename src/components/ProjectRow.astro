---
import type { CollectionEntry } from 'astro:content';
import LangDot from './LangDot.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { name, description, language, url } = Astro.props.project.data;
const label = new URL(url).hostname === 'github.com' ? 'github' : 'site';
---

<a
  href={url}
  data-item
  data-language={language}
  class="group flex flex-col gap-2 border-line border-b py-4 text-fg lg:px-3 hover:bg-surface hover:no-underline lg:grid lg:grid-cols-[13.75rem_9.375rem_minmax(0,1fr)_5.625rem] lg:items-center lg:gap-6"
>
  <span class="font-semibold text-accent group-hover:underline">{name}/</span>
  <span class="flex items-center gap-2 text-sm"><LangDot language={language} /><span class="text-dim">{language}</span></span>
  <span class="text-md">{description}</span>
  <span class="text-dim text-xs lg:text-right">{label} →</span>
</a>
