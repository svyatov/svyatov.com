---
interface Props {
  href: string;
  active?: boolean;
  [key: string]: unknown;
}

const { href, active = false, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    'border px-2 py-0.5 text-xs hover:no-underline',
    active ? 'border-accent text-accent' : 'border-line text-dim hover:border-accent hover:text-accent',
  ]}
  {...rest}><slot /></a>
