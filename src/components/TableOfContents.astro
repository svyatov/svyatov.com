---
interface Props {
  headings: { slug: string; text: string }[];
}

const { headings } = Astro.props;
---

{headings.length > 0 && (
  <nav aria-label="On this page" class="flex flex-col gap-2.5" data-toc>
    <h2 class="font-semibold text-2xs text-fg tracking-label">ON THIS PAGE</h2>
    {headings.map((h) => (
      <a href={`#${h.slug}`} class="text-dim aria-[current=true]:text-fg">{h.text}</a>
    ))}
  </nav>
)}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  const headings = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  const observer = new IntersectionObserver(
    (entries) => {
      const hit = entries.findLast((e) => e.isIntersecting);
      if (!hit) return;
      for (const [i, h] of headings.entries()) {
        links[i]?.setAttribute('aria-current', h === hit.target ? 'true' : 'false');
      }
    },
    { rootMargin: '0px 0px -70% 0px' },
  );
  for (const h of headings) if (h) observer.observe(h);
</script>
