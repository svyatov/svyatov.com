---
import Banner from '../components/Banner.astro';
import SectionRule from '../components/SectionRule.astro';
import { banners } from '../data/banners';
import { cv } from '../data/cv';
import Base from '../layouts/Base.astro';
import { duration } from '../lib/cv';
import { site } from '../site';

const contacts = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: 'linkedin.com/in/leonid-svyatov', href: 'https://www.linkedin.com/in/leonid-svyatov' },
  { label: 'github.com/svyatov', href: 'https://github.com/svyatov' },
];
---

<Base title="CV" description={cv.summary}>
  <section class="flex flex-col gap-6 px-4 pt-10 pb-8 md:px-20 md:pt-18 md:pb-10">
    <div class="flex flex-col gap-4">
      <Banner fonts={banners.cv} />
      <div class="text-lg">
        <p class="text-dim">$ cat ~/cv.md</p>
        <h1 class="inline font-semibold text-3xl">{site.name}</h1><span class="text-dim"> · {cv.title}</span>
      </div>
      <div class="flex flex-wrap gap-5 text-sm">
        {contacts.map((c) => <a href={c.href}>{c.label}</a>)}
        <span class="text-dim">{cv.location}</span>
      </div>
    </div>
    <div class="flex flex-col items-start gap-6 md:flex-row md:justify-between">
      <p class="max-w-summary border border-line bg-surface px-6 py-5 leading-summary">{cv.summary}</p>
      <a
        href="/cv.pdf"
        class="inline-flex h-11.5 shrink-0 items-center border border-accent px-5 font-medium text-accent tracking-btn print:hidden hover:bg-accent hover:text-bg hover:no-underline"
      >
        [ download pdf ]
      </a>
    </div>
  </section>

  <SectionRule title="WORK EXPERIENCE">{cv.span}</SectionRule>
  <div class="flex flex-col px-4 pt-2 pb-10 md:px-20 md:pb-14">
    {
      cv.experience.map((job) => (
        <article class="flex flex-col gap-3 border-line border-b py-7 md:grid md:grid-cols-[12.5rem_minmax(0,1fr)] md:items-baseline md:gap-8">
          <div class="flex flex-col gap-1 text-dim text-sm">
            <p>{job.period}</p>
            <p class="text-xs">{duration(job.period)} · {job.type}</p>
            <p class="text-xs">{job.location}</p>
          </div>
          <div class="flex flex-col gap-3.5">
            <h3 class="flex flex-wrap items-baseline gap-3">
              <span class="font-semibold text-accent text-xl">{job.company}</span>
              <span class="text-dim">·</span>
              <span class="font-medium">{job.role}</span>
            </h3>
            <p class="text-md leading-summary">{job.story}</p>
          </div>
        </article>
      ))
    }
  </div>

  <SectionRule title="CORE SKILLS" />
  <ul class="grid gap-x-10 gap-y-2.5 px-4 pt-7 pb-10 sm:grid-cols-2 md:px-20 md:pb-14 xl:grid-cols-3">
    {
      cv.skills.map((s) => (
        <li class="flex gap-2.5 text-sm">
          <span class="text-accent">+</span>
          <span>{s}</span>
        </li>
      ))
    }
  </ul>

  <div class="flex flex-wrap gap-x-20 gap-y-10 px-4 pb-10 md:px-20 md:pb-14">
    <div class="flex grow flex-col gap-4">
      <SectionRule title="EDUCATION" padded={false} />
      <div class="flex flex-col gap-1 text-md">
        <span class="font-semibold">{cv.education.school}</span>
        <span class="text-dim">{cv.education.where}</span>
        <span>{cv.education.degree}</span>
      </div>
    </div>
    <div class="flex grow flex-col gap-4">
      <SectionRule title="LANGUAGES" padded={false} />
      <div class="flex gap-3 text-md">
        {cv.languages.map((l, i) => (
          <>
            {i > 0 && <span class="text-dim">·</span>}
            <span>{l}</span>
          </>
        ))}
      </div>
    </div>
  </div>
</Base>
