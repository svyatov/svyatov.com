---
import Banner from '../components/Banner.astro';
import SectionRule from '../components/SectionRule.astro';
import { banners } from '../data/banners';
import { cv } from '../data/cv';
import Base from '../layouts/Base.astro';
import { duration } from '../lib/cv';
import { site } from '../site';

const social = (label: string) => site.socials.find((s) => s.label === label)?.href;
const contacts = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: 'linkedin.com/in/leonid-svyatov', href: social('linkedin') },
  { label: 'github.com/svyatov', href: social('github') },
];
---

<Base title="CV" description={cv.summary}>
  <section class="flex flex-col gap-6 px-4 pt-10 pb-8 md:px-20 md:pt-18 md:pb-10">
    <div class="flex flex-col gap-4">
      <Banner fonts={banners.cv} />
      <div class="text-lg">
        <p class="text-dim">$ cat ~/cv.md</p>
        <h1 class="inline font-semibold text-3xl">{site.name}</h1><span class="text-dim"><span class="hidden md:inline"> · </span><span class="block md:inline">{site.jobTitle}</span></span>
      </div>
      <div class="flex flex-col gap-2 text-sm md:flex-row md:flex-wrap md:gap-5">
        {contacts.map((c) => <a href={c.href}>{c.label}</a>)}
        <span class="text-dim">{cv.location}</span>
      </div>
    </div>
    <div class="flex flex-col items-start gap-6 md:flex-row md:justify-between">
      <p class="max-w-summary border border-line bg-surface px-4 py-4 leading-summary md:px-6 md:py-5">{cv.summary}</p>
      <a
        href="/CV.pdf"
        class="inline-flex h-9 shrink-0 items-center self-center border border-accent px-4 font-medium text-accent text-sm tracking-btn md:h-11.5 md:self-auto md:px-5 md:text-base print:hidden hover:bg-accent hover:text-bg"
      >
        [ download pdf ]
      </a>
    </div>
  </section>

  <SectionRule title="WORK EXPERIENCE" short="EXPERIENCE" />
  <div class="flex flex-col divide-y divide-line px-4 pb-10 md:px-20 md:pb-14">
    {
      cv.experience.map((job) => (
        <article class="flex flex-col gap-3 py-7 md:grid md:grid-cols-[18rem_minmax(0,1fr)] md:items-baseline md:gap-8">
          <div class="flex flex-col gap-1 text-dim text-sm">
            <p>{[job.period, duration(job.period)].filter(Boolean).join(' · ')}</p>
            <p class="text-xs">{[job.location, job.type].filter(Boolean).join(' · ')}</p>
          </div>
          <div class="flex flex-col gap-3.5">
            <h3 class="flex flex-col gap-1 md:flex-row md:flex-wrap md:items-baseline md:gap-3">
              <span class="font-semibold text-xl">{job.company}</span>
              <span class="hidden text-dim md:inline">·</span>
              <span class="font-medium">{job.role}</span>
            </h3>
            <p class="text-md leading-summary">{job.story}</p>
          </div>
        </article>
      ))
    }
  </div>

  <SectionRule title="CORE SKILLS" />
  <ul class="grid gap-x-10 gap-y-2.5 px-4 pt-5 pb-10 sm:grid-cols-2 md:px-20 md:pb-14 xl:grid-cols-3">
    {
      cv.skills.map((s) => (
        <li class="flex gap-2.5 text-sm">
          <span>+</span>
          <span>{s}</span>
        </li>
      ))
    }
  </ul>

  <div class="flex flex-wrap gap-x-20 gap-y-10 px-4 pb-10 md:px-20 md:pb-14">
    <div class="flex grow flex-col gap-4">
      <SectionRule title="EDUCATION" padded={false} />
      <div class="flex flex-col gap-1 text-md">
        <span class="font-semibold">{cv.education.school}</span>
        <span>{cv.education.degree}</span>
      </div>
    </div>
    <div class="flex grow flex-col gap-4">
      <SectionRule title="LANGUAGES" padded={false} />
      <div class="flex flex-wrap gap-3 text-md">
        {cv.languages.map((l, i) => (
          <>
            {i > 0 && <span class="text-dim">·</span>}
            <span>{l}</span>
          </>
        ))}
      </div>
    </div>
  </div>

  <SectionRule title="RECOMMENDATIONS">
    <a href="https://www.linkedin.com/in/leonid-svyatov/details/recommendations/"><span class="hidden md:inline">originals on </span>linkedin <span class="relative -top-px">→</span></a>
  </SectionRule>
  <div class="flex flex-col divide-y divide-line px-4 pb-10 md:px-20 md:pb-14">
    {
      cv.recommendations.map((r) => (
        <article class="flex flex-col gap-3 py-7 md:grid md:grid-cols-[18rem_minmax(0,1fr)] md:items-baseline md:gap-8">
          <div class="flex flex-col gap-1 text-sm">
            <p class="font-semibold">{r.name}</p>
            <p class="text-dim">{r.title}</p>
            <p class="text-dim text-xs">{r.date} · {r.relation}</p>
          </div>
          <blockquote class="flex flex-col gap-3 text-md leading-summary">
            {r.quote.map((p) => <p>{p}</p>)}
          </blockquote>
        </article>
      ))
    }
  </div>
</Base>
