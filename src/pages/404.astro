---
import Banner from '../components/Banner.astro';
import { banners } from '../data/banners';
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Page not found.">
  <section class="flex flex-col gap-5 px-4 pt-10 pb-10 md:px-20 md:pt-18 md:pb-18">
    <Banner text={banners.notFound} />
    <div class="flex flex-col gap-1.5 text-prose md:text-2xl md:leading-hero">
      <p class="text-dim">$ cat {Astro.url.pathname}</p>
      <h1>cat: no such file or directory<span class="cursor-blink"></span></h1>
    </div>
    <div class="flex flex-wrap gap-5 text-sm">
      <a href="/">[ cd ~ ]</a><a href="/blog/">[ tail -f ~/blog ]</a><a href="/projects/">[ ls -la ~/oss ]</a>
    </div>
  </section>
</Base>
