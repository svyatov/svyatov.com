---
import { getCollection } from 'astro:content';
import Banner from '../components/Banner.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { banners } from '../data/banners';
import Base from '../layouts/Base.astro';
import { byCountDesc, countBy } from '../lib/posts';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime(),
);
const languages = [...countBy(projects, (p) => [p.data.language])].sort(byCountDesc);
---

<Base title="Projects" description="Open-source libraries and tools by Leonid Svyatov: Ruby gems, TypeScript, Go.">
  <section class="flex flex-col gap-5 px-4 pt-10 pb-4 md:px-20 md:pt-18 md:pb-10">
    <Banner fonts={banners.projects} />
    <div class="text-lg">
      <p class="text-dim">$ ls -la ~/oss</p>
      <h1>Open-source libraries and tools I maintain. Descriptions and languages pulled from GitHub at build time.<span class="cursor-blink"></span></h1>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2.5 text-sm" data-filter>
      <span class="text-dim">filter:</span>
      <button type="button" aria-pressed="true" class="cursor-pointer border border-accent px-2 py-1 text-accent text-xs" data-language="">all ({projects.length})</button>
      {
        languages.map(([lang, n]) => (
          <button type="button" aria-pressed="false" class="cursor-pointer border border-line px-2 py-1 text-dim text-xs" data-language={lang}>
            {String(lang).toLowerCase()} ({n})
          </button>
        ))
      }
    </div>
  </section>
  <div class="flex flex-col px-4 pb-10 md:px-20 md:pb-14">
    <div
      class="hidden grid-cols-[13.75rem_9.375rem_minmax(0,1fr)_5.625rem] gap-6 border-accent border-b px-3 py-2 text-2xs text-dim tracking-label md:grid"
    >
      <span>NAME</span><span>LANG</span><span>DESCRIPTION</span><span class="text-right">LINK</span>
    </div>
    {projects.map((p) => <ProjectRow project={p} />)}
    <p class="py-4 text-dim text-xs md:px-3">
      total {projects.length} · also: <a href="https://rubygems.org/profiles/svyatov">gems on rubygems.org</a> ·
      <a href="https://www.npmjs.com/~svyatov">packages on npm</a>
    </p>
  </div>
  <script>
    const filter = document.querySelector<HTMLElement>('[data-filter]');
    const rows = document.querySelectorAll<HTMLElement>('a[data-language]');
    filter?.addEventListener('click', (e) => {
      const tag = (e.target as HTMLElement).closest<HTMLElement>('button[data-language]');
      if (!tag) return;
      e.preventDefault();
      const lang = tag.dataset.language ?? '';
      for (const t of filter.querySelectorAll<HTMLElement>('button[data-language]')) {
        const on = t === tag;
        t.setAttribute('aria-pressed', String(on));
        t.classList.toggle('border-accent', on);
        t.classList.toggle('text-accent', on);
        t.classList.toggle('border-line', !on);
        t.classList.toggle('text-dim', !on);
      }
      for (const row of rows) row.classList.toggle('hidden!', lang !== '' && row.dataset.language !== lang);
    });
  </script>
</Base>
