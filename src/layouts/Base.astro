---
import '../styles/global.css';
import type { ComponentProps } from 'astro/types';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import { site } from '../site';

type Props = ComponentProps<typeof Head>;

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-bg text-fg font-mono antialiased">
  <head>
    <Head {...props} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header path={Astro.url.pathname} />
    <main class="flex flex-col"><slot /></main>
    <Footer />
    {site.scanlines && <div aria-hidden="true" class="scanlines fixed inset-0 z-20 print:hidden" />}
    <dialog
      id="keys"
      class="m-auto min-w-64 border border-line bg-surface p-5 text-fg text-sm backdrop:bg-bg/70"
    >
      <p class="mb-3 font-semibold text-2xs text-accent tracking-label">KEYS</p>
      <ul class="flex flex-col gap-1.5">
        {
          [
            ...site.nav.map((item) => [item.key, item.key + item.rest]),
            ['-', 'up one level'],
            [',', 'prev', ', .'],
            ['.', 'next', ', .'],
            ['j', 'next item'],
            ['k', 'prev item'],
            ['[', 'prev heading'],
            [']', 'next heading'],
            ['u', 'top'],
            ['d', 'bottom'],
            ['y', 'copy url'],
            ...site.socials.filter((s) => 'key' in s).map((s) => [s.key, s.label]),
            ['m', 'email'],
          ].map(([key, label, when = key]) => (
            <li data-for={when}>
              <span class="text-accent">{key}</span> <span class="text-dim">{label}</span>
            </li>
          ))
        }
        <li><span class="text-accent">?</span> <span class="text-dim">this list</span></li>
        <li><span class="text-accent">esc</span> <span class="text-dim">close</span></li>
      </ul>
    </dialog>
    <output data-toast class="fixed right-4 bottom-4 z-30 border border-line bg-surface px-3 py-1.5 text-xs opacity-0 transition-opacity">url copied</output>
    <script>
      import { site } from '../site';

      // Keys: a string navigates, a function runs. Help rows hide when none of their data-for keys are bound on this page.
      const dialog = document.querySelector<HTMLDialogElement>('#keys');
      const keys = new Map<string, string | (() => void)>();
      for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-key]')) keys.set(a.dataset.key ?? '', a.href);
      for (const s of site.socials) if ('key' in s) keys.set(s.key, () => open(s.href, '_blank', 'noopener'));
      keys.set('m', `mailto:${site.email}`);
      const up = location.pathname.replace(/[^/]+\/$/, '');
      if (up !== location.pathname) keys.set('-', up);
      const items = [...document.querySelectorAll<HTMLElement>('main a[data-item]')];
      const move = (d: number) => () => {
        const i = items.indexOf(document.activeElement as HTMLElement) + d;
        items[Math.max(0, Math.min(items.length - 1, i))]?.focus();
      };
      if (items.length) keys.set('j', move(1)).set('k', move(-1));
      const heads = [...document.querySelectorAll<HTMLElement>('.prose h2')];
      const top = (h: HTMLElement) => h.getBoundingClientRect().top;
      if (heads.length) {
        keys.set(']', () => heads.find((h) => top(h) > 2)?.scrollIntoView());
        keys.set('[', () => heads.findLast((h) => top(h) < -2)?.scrollIntoView());
      }
      keys.set('u', () => scrollTo(0, 0)).set('d', () => scrollTo(0, document.body.scrollHeight));
      keys.set('Escape', () => (document.activeElement as HTMLElement | null)?.blur());
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      keys.set('y', () =>
        navigator.clipboard.writeText(location.href).then(() => {
          toast?.style.setProperty('opacity', '1');
          setTimeout(() => toast?.style.removeProperty('opacity'), 1200);
        }),
      );
      for (const li of dialog?.querySelectorAll<HTMLElement>('[data-for]') ?? []) {
        li.hidden = !(li.dataset.for ?? '').split(' ').some((k) => keys.has(k));
      }
      document.querySelector('[data-keys-open]')?.addEventListener('click', () => dialog?.showModal());
      document.addEventListener('keydown', (e) => {
        const target = e.target as Element;
        if (e.metaKey || e.ctrlKey || e.altKey || target.closest?.('input, textarea, [contenteditable]')) return;
        if (e.key === '?' || (e.key === '/' && e.shiftKey)) return dialog?.open ? dialog.close() : dialog?.showModal();
        const k = keys.get(e.key);
        if (typeof k === 'function') k();
        else if (k) location.assign(k);
      });

      // Lead headings: type the text in front of the cursor once per section (home, projects, blog) per tab session.
      // The full text stays in the DOM (invisible) so nothing reflows.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const section = `typed:${location.pathname.split('/')[1]}`;
      let store: Storage | undefined;
      try {
        store = sessionStorage; // throws when cookies are blocked, then the animation never plays
      } catch {}
      if (store && !store.getItem(section) && !reduced) {
        for (const h1 of document.querySelectorAll<HTMLElement>('h1[data-type]')) {
          store.setItem(section, '1');
          const text = h1.firstChild?.textContent ?? '';
          const typed = document.createTextNode('');
          const rest = document.createElement('span');
          rest.className = 'invisible';
          h1.replaceChildren(typed, ...h1.querySelectorAll('.cursor-blink'), rest);
          let i = 0;
          const step = () => {
            typed.data = text.slice(0, ++i);
            rest.textContent = text.slice(i);
            if (i < text.length) setTimeout(step, 10 + Math.random() * 30);
          };
          step();
        }
      }

      // Click burst: a ring of ascii sparks drifts out from the pointer and fades.
      if (!reduced) {
        document.addEventListener('click', ({ clientX, clientY, target }) => {
          if ((target as Element).closest?.('a')) return; // navigation would cut the burst mid-flight
          for (let k = 0; k < 12; k++) {
            const angle = (k / 12) * Math.PI * 2;
            const reach = 2.5 + Math.random() * 1.5;
            const spark = document.body.appendChild(document.createElement('span'));
            spark.className = 'pointer-events-none fixed z-30 select-none text-accent text-lg';
            spark.textContent = '.*+*'[Math.floor(Math.random() * 4)];
            spark.style.left = `${clientX}px`;
            spark.style.top = `${clientY}px`;
            spark.animate(
              [
                { translate: '-50% -50%', opacity: 1 },
                {
                  translate: `calc(-50% + ${(Math.cos(angle) * reach).toFixed(2)}rem) calc(-50% + ${(Math.sin(angle) * reach).toFixed(2)}rem)`,
                  opacity: 0,
                },
              ],
              { duration: 700, easing: 'cubic-bezier(0.1, 0.7, 0.3, 1)' },
            ).onfinish = () => spark.remove();
          }
        });
      }
    </script>
  </body>
</html>
