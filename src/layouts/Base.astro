---
import '../styles/global.css';
import type { ComponentProps } from 'astro/types';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import { site } from '../site';

type Props = ComponentProps<typeof Head>;

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-bg text-fg font-mono antialiased">
  <head>
    <Head {...props} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header path={Astro.url.pathname} />
    <main id="main" tabindex="-1" class="flex flex-col"><slot /></main>
    <Footer />
    <div aria-hidden="true" class="scanlines fixed inset-0 z-20 print:hidden"></div>
    <dialog
      id="keys"
      aria-labelledby="keys-title"
      class="m-auto min-w-64 border border-line bg-surface p-5 text-fg text-sm backdrop:bg-bg/70"
    >
      <h2 id="keys-title" class="mb-3 font-semibold">Hotkeys</h2>
      <button type="button" data-keys-close autofocus aria-label="Close" class="absolute top-2 right-2 flex size-7 cursor-pointer items-center justify-center text-dim text-lg leading-none hover:text-accent focus-visible:text-accent focus-visible:outline-offset-0">×</button>
      <label class="mb-3 flex items-center gap-2"><input type="checkbox" data-shortcuts checked /> Enable single-key shortcuts</label>
      <ul class="flex flex-col gap-1.5">
        {
          [
            ...site.nav.map((item) => [item.key, item.key + item.rest]),
            ['-', 'up one level'],
            [',', 'prev', ', .'],
            ['.', 'next', ', .'],
            ['j', 'next item'],
            ['k', 'prev item'],
            ['[', 'prev heading'],
            [']', 'next heading'],
            ['u', 'top'],
            ['d', 'bottom'],
            ['y', 'copy url'],
            ...site.socials.filter((s) => 'key' in s).map((s) => [s.key, s.label]),
            ['m', 'email'],
          ].map(([key, label, when = key]) => (
            <li data-for={when}>
              <span>{key}</span> <span class="text-dim">{label}</span>
            </li>
          ))
        }
        <li><span>?</span> <span class="text-dim">this list</span></li>
        <li><span>esc</span> <span class="text-dim">close</span></li>
      </ul>
    </dialog>
    <output data-toast aria-live="polite" aria-atomic="true" class="fixed right-4 bottom-4 z-30 border border-line bg-surface px-3 py-1.5 text-xs opacity-0 transition-opacity"></output>
    <script>
      import { copyText } from '../lib/clipboard';
      import { site } from '../site';

      // Keys: a string navigates, a function runs. Help rows hide when none of their data-for keys are bound on this page.
      const dialog = document.querySelector<HTMLDialogElement>('#keys');
      const keys = new Map<string, string | (() => void)>();
      for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-key]')) keys.set(a.dataset.key ?? '', a.href);
      for (const s of site.socials) if ('key' in s) keys.set(s.key, () => open(s.href, '_blank', 'noopener'));
      keys.set('m', `mailto:${site.email}`);
      const up = location.pathname.replace(/[^/]+\/$/, '');
      if (up !== location.pathname) keys.set('-', up);
      const items = [...document.querySelectorAll<HTMLElement>('main a[data-item]')];
      const move = (d: number) => () => {
        const visible = items.filter((item) => item.getClientRects().length > 0);
        const i = visible.indexOf(document.activeElement as HTMLElement) + d;
        visible[Math.max(0, Math.min(visible.length - 1, i))]?.focus();
      };
      if (items.length) keys.set('j', move(1)).set('k', move(-1));
      const heads = [...document.querySelectorAll<HTMLElement>('.prose h2')];
      const top = (h: HTMLElement) => h.getBoundingClientRect().top;
      if (heads.length) {
        keys.set(']', () => heads.find((h) => top(h) > 2)?.scrollIntoView());
        keys.set('[', () => heads.findLast((h) => top(h) < -2)?.scrollIntoView());
      }
      keys.set('u', () => scrollTo(0, 0)).set('d', () => scrollTo(0, document.body.scrollHeight));
      keys.set('y', () => { void copyText(location.href, 'URL'); });
      for (const li of dialog?.querySelectorAll<HTMLElement>('[data-for]') ?? []) {
        li.hidden = !(li.dataset.for ?? '').split(' ').some((k) => keys.has(k));
      }
      const toggle = document.querySelector<HTMLInputElement>('[data-shortcuts]');
      let shortcuts = true;
      try { shortcuts = localStorage.getItem('shortcuts') !== 'off'; } catch {}
      if (toggle) toggle.checked = shortcuts;
      toggle?.addEventListener('change', () => {
        shortcuts = toggle.checked;
        try { localStorage.setItem('shortcuts', shortcuts ? 'on' : 'off'); } catch {}
      });
      let returnFocus: HTMLElement | null = null;
      const showHelp = () => {
        returnFocus = document.activeElement as HTMLElement | null;
        dialog?.showModal();
      };
      document.querySelector('[data-keys-open]')?.addEventListener('click', showHelp);
      document.querySelector('[data-keys-close]')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('close', () => returnFocus?.focus());
      dialog?.addEventListener('keydown', (event) => {
        if (event.key !== 'Tab') return;
        const controls = [...dialog.querySelectorAll<HTMLElement>('button, input')];
        const first = controls[0];
        const last = controls.at(-1);
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      });
      document.addEventListener('keydown', (e) => {
        const target = e.target as Element;
        if (dialog?.open || !shortcuts || e.defaultPrevented || e.repeat || e.isComposing || e.metaKey || e.ctrlKey || e.altKey || target.closest?.('input, textarea, select, [contenteditable]:not([contenteditable="false"])')) return;
        if (e.key === '?') { e.preventDefault(); showHelp(); return; }
        const k = keys.get(e.key);
        if (k) e.preventDefault();
        if (typeof k === 'function') k();
        else if (k) location.assign(k);
      });

      // Click burst: a ring of ascii sparks drifts out from the pointer and fades.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.addEventListener('click', ({ clientX, clientY, target }) => {
          if ((target as Element).closest?.('a')) return; // navigation would cut the burst mid-flight
          for (let k = 0; k < 12; k++) {
            const angle = (k / 12) * Math.PI * 2;
            const reach = 2.5 + Math.random() * 1.5;
            const spark = document.body.appendChild(document.createElement('span'));
            spark.className = 'pointer-events-none fixed z-30 select-none text-accent text-lg';
            spark.textContent = '.*+*'[Math.floor(Math.random() * 4)];
            spark.style.left = `${clientX}px`;
            spark.style.top = `${clientY}px`;
            spark.animate(
              [
                { translate: '-50% -50%', opacity: 1 },
                {
                  translate: `calc(-50% + ${(Math.cos(angle) * reach).toFixed(2)}rem) calc(-50% + ${(Math.sin(angle) * reach).toFixed(2)}rem)`,
                  opacity: 0,
                },
              ],
              { duration: 700, easing: 'cubic-bezier(0.1, 0.7, 0.3, 1)' },
            ).onfinish = () => spark.remove();
          }
        });
      }
    </script>
  </body>
</html>
